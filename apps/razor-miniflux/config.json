{
  "$schema": "https://schemas.runtipi.io/v2/app-info.json",
  "name": "Razor Miniflux",
  "id": "razor-miniflux",
  "available": true,
  "short_desc": "Razor Miniflux",
  "author": "Rodrigo Mescua",
  "port": 8822,
  "categories": [
    "featured"
  ],
  "description": "Aplicativo para gerenciar feed RSS hospedado no Miniflux.",
  "tipi_version": 128,
  "version": "202610191845",
  "source": "https://github.com/rodrigomescua/RazorMiniflux",
  "exposable": true,
  "dynamic_config": true,
  "supported_architectures": [
    "amd64"
  ],
  "created_at": 1731806736001,
  "updated_at": 1792435679993,
  "form_fields": [
    {
      "type": "text",
      "label": "FreshRSS Pg Connection String",
      "max": 300,
      "min": 3,
      "required": true,
      "env_variable": "FRESHRSS_CONNECTIONSTRING"
    },
    {
      "type": "text",
      "label": "FreshRSS Table Prefix",
      "max": 120,
      "min": 5,
      "default": "rssrodrigo",
      "required": true,
      "env_variable": "FRESHRSS_TABLE_PREFIX"
    },
    {
      "type": "text",
      "label": "FreshRSS Top Table Prefix",
      "max": 120,
      "min": 5,
      "default": "rssmurkmesc",
      "required": true,
      "env_variable": "FRESHRSS_TOP_TABLE_PREFIX"
    },
    {
      "type": "text",
      "label": "Page Size",
      "required": false,
      "default": "10",
      "max": 2,
      "min": 1,
      "env_variable": "PAGE_SIZE"
    },
    {
      "type": "text",
      "label": "Server Page Size",
      "required": false,
      "default": "500",
      "max": 5,
      "min": 1,
      "env_variable": "SERVER_PAGE_SIZE"
    },
    {
      "type": "text",
      "label": "Mark Starred as Read",
      "required": false,
      "default": "true",
      "max": 5,
      "min": 1,
      "env_variable": "MARK_STARRED_READ"
    },
    {
      "type": "text",
      "label": "Exclusive Top hostname",
      "required": false,
      "env_variable": "TOP_MODE_HOST",
      "hint": "Hostname only, without https://, port or path. All other domains use Normal mode."
    },
    {
      "type": "password",
      "label": "Top access PIN",
      "required": false,
      "min": 6,
      "max": 128,
      "env_variable": "TOP_MODE_PIN",
      "hint": "6 to 128 digits. Required only on the exclusive Top hostname."
    },
    {
      "type": "text",
      "label": "Trusted proxy IPs / CIDRs",
      "required": false,
      "env_variable": "TRUSTED_PROXIES",
      "hint": "Exemplos: 192.168.1.10 (um proxy); 192.168.1.10,172.18.0.2 (dois proxies); 172.18.0.0/24 (rede Docker dedicada e confiável). Use os IPs do proxy vistos pelo container, não os IPs dos clientes. Sem URLs ou portas."
    }
  ],
  "urn": "tipi://razor-miniflux"
}
